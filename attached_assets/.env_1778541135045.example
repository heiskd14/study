# ==========================================
# NexAuth — Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# ── Server ──
PORT=5000
NODE_ENV=development

# ── CORS ──
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── JWT ──
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_STRING_64_CHARS_MIN

# ── Database ──
# Choose: mongodb | mysql
DB_TYPE=mongodb

# ── MongoDB ──
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=nexauth

# ── MySQL (if DB_TYPE=mysql) ──
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=nexauth
